<?xml version="1.0" encoding="utf-8"?>
<Activity mc:Ignorable="sap sap2010" x:Class="PowerPointAutomation" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:pp="http://schemas.uipath.com/workflow/activities/presentations">
  <Sequence DisplayName="PowerPoint Automation"><Sequence.Variables><Variable x:TypeArguments="x:String" Name="filePath" /></Sequence.Variables>
    <Assign><Assign.To><OutArgument x:TypeArguments="x:String">[filePath]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(in_OutputFolder,"OfficePresentation.pptx")]</InArgument></Assign.Value></Assign>
    <pp:CreatePresentation DisplayName="Create Office presentation" PresentationPath="[filePath]"><pp:CreatePresentation.Body><Sequence><pp:AddSlide DisplayName="Add summary slide" Layout="TitleOnly"><pp:AddSlide.Body><Sequence><pp:TypeIntoSlideElement Text="Smart Office Automation System" ElementName="Title 1" /><pp:TypeIntoSlideElement Text="Data created by Excel automation and consumed by PowerPoint and Word" ElementName="Subtitle 2" /></Sequence></pp:AddSlide.Body></pp:AddSlide></Sequence></pp:CreatePresentation.Body></pp:CreatePresentation>
  </Sequence><x:Members><x:Property Name="in_OutputFolder" Type="InArgument(x:String)" /></x:Members>
</Activity>
